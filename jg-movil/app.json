{
  "expo": {
    "name": "JG Movil",
    "slug": "jg-movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logos/Logo carrito JG vista app.png",
    "scheme": "jgmovil",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sherman60.jgmovil"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6EBD7",
        "foregroundImage": "./assets/images/logos/Logo carrito JG vista app.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sherman60.jgmovil",
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logos/Logo carrito JG.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#F6EBD7",
          "dark": {
            "image": "./assets/images/logos/Logo carrito JG.png",
            "backgroundColor": "#402612"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "apiUrl": "http://localhost:3000/api",
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "eas": {
        "projectId": "24fac00f-2d7c-4412-8499-5f297947e822"
      }
    }
  }
}
